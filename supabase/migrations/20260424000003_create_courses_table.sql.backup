-- Migration: Create Courses Table
-- Description: Creates the courses table for tracking course information referenced in reports
-- Created: 2026-04-24

-- Create courses table
CREATE TABLE IF NOT EXISTS courses (
  course_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  course_code VARCHAR(50) NOT NULL, -- e.g., "MATH_101", "ENG_102"
  course_name VARCHAR(255) NOT NULL,
  department VARCHAR(100),
  is_active BOOLEAN DEFAULT true,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Create unique index on course_code
CREATE UNIQUE INDEX IF NOT EXISTS idx_courses_code ON courses(course_code);

-- Create index for department lookups
CREATE INDEX IF NOT EXISTS idx_courses_department ON courses(department);
CREATE INDEX IF NOT EXISTS idx_courses_active ON courses(is_active);

-- Add trigger to auto-update updated_at timestamp
CREATE OR REPLACE FUNCTION update_courses_updated_at()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_update_courses_updated_at
  BEFORE UPDATE ON courses
  FOR EACH ROW
  EXECUTE FUNCTION update_courses_updated_at();

-- Add comments for documentation
COMMENT ON TABLE courses IS 'Stores course information for reference in client reports';
COMMENT ON COLUMN courses.course_code IS 'Unique course identifier (e.g., MATH_101)';
COMMENT ON COLUMN courses.is_active IS 'Whether this course is currently offered';
